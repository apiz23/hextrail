# Add Supabase values after creating a project. Never commit real secrets.
#
# Project URL. Browser-safe: NEXT_PUBLIC_ values are bundled into the client.
# Read by src/lib/supabase/service.ts.
NEXT_PUBLIC_SUPABASE_URL=

# Browser-safe anon key. Reserved — not read by any code. Authentication is
# custom (sessions in hx_sessions), not Supabase Auth, so this is unused.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required. Used by the ingestion endpoint (POST /api/v1/traces),
# session validation, and every dashboard query. Bypasses Row Level Security —
# it must never be imported into a client component, and must NEVER be given a
# NEXT_PUBLIC_ prefix. The `server-only` guard in src/lib/supabase/service.ts
# makes such an import a build error, and CI checks the built output for the key.
SUPABASE_SERVICE_ROLE_KEY=

# Reserved for the future SDK ingestion contract. Not read by any code yet;
# the current endpoint authenticates with project-scoped API keys instead.
HEXTRAIL_INGESTION_SECRET=

# --- Rate limiting (optional) -------------------------------------------------
# Requests allowed per window, per API key. Defaults to 600.
# HEXTRAIL_RATE_LIMIT=
# Window length in seconds. Defaults to 60.
# HEXTRAIL_RATE_WINDOW_SECONDS=
# Set to "memory" to use a per-process limiter. LOCAL DEVELOPMENT ONLY: it is
# not distributed, so it does not enforce a real limit across serverless
# instances. Anything else uses the Postgres store (migration 0004).
# HEXTRAIL_RATE_LIMIT_STORE=

# --- Integration tests (optional) ---------------------------------------------
# An ISOLATED throwaway project. The suite writes rows and deletes them, and it
# refuses to run if TEST_SUPABASE_URL equals NEXT_PUBLIC_SUPABASE_URL.
# TEST_SUPABASE_URL=
# TEST_SUPABASE_SERVICE_ROLE_KEY=
