{
  "name": "@hextrail/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for Hextrail — send AI agent execution traces to your Hextrail project.",
  "license": "MIT",
  "homepage": "https://hextrail.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hextrail/hextrail.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/hextrail/hextrail/issues"
  },
  "keywords": [
    "hextrail",
    "observability",
    "tracing",
    "llm",
    "ai-agents",
    "telemetry",
    "opentelemetry"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "default": "./dist/schema.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "pnpm run clean && pnpm run build && pnpm run test && cd ../.. && node scripts/release-check.mjs --skip-install",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
